{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/cardan-review.mjs\" drift"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/cardan-review.mjs\" gate"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^cardan-reviewer$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/cardan-review.mjs\" start"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^cardan-reviewer$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/cardan-review.mjs\" mark"
          }
        ]
      }
    ]
  }
}
